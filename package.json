{
  "name": "prompt-engineering-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "typecheck": "node scripts/astro.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-browser-tests.mjs dev",
    "check:links": "node scripts/check-links.mjs",
    "test:links": "node --test scripts/check-links.test.mjs",
    "check:static": "node scripts/check-static.mjs",
    "test:static": "node --test scripts/check-static.test.mjs",
    "test:static-browser": "node scripts/run-browser-tests.mjs static",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.6",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
