---
import '../styles/tokens.css';
import '../styles/global.css';
import Matrix from '../components/Matrix.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import AwardNotifications from '../islands/AwardNotifications';
import { route } from '../domain/navigation';
interface Props { title: string; description?: string }
const { title, description = 'Практический маршрут от устройства языковых моделей до безопасной работы с AI.' } = Astro.props;
---
<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={route('/favicon.svg')} />
    <title>{title} | Prompt Engineering Academy</title>
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержимому</a>
    <Matrix />
    <header>
      <a class="brand" href={route('/')} aria-label="Prompt Engineering Academy – главная">
        <svg viewBox="0 0 56 64" width="44" height="50" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M28 2 53 17v30L28 62 3 47V17Z"/><path d="m28 17 13 8v15l-13 8-13-8V25Z"/><circle cx="28" cy="17" r="3"/><circle cx="15" cy="40" r="3"/><circle cx="41" cy="40" r="3"/></svg>
        <span>Prompt Engineering<br />Academy</span>
      </a>
      <nav aria-label="Основная навигация"><a href={route('/#missions')}>Практические задания</a><a href={route('/quiz/')}>Итоговый тест</a></nav>
      <ThemeSwitch />
    </header>
    <main id="main"><slot /></main>
    <AwardNotifications client:load />
    <footer><span>Учитесь осознанно. Проверяйте результат.</span><a href={route('/about/')}>О проекте</a></footer>
  </body>
</html>
<style>
  header { max-width: 1440px; margin: auto; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; padding: 1.5rem 2rem; border-bottom: 1px solid var(--border-subtle); }
  .brand { display: flex; gap: .8rem; align-items: center; text-decoration: none; color: var(--text-primary); font-size: 1.25rem; font-weight: 600; line-height: 1.2; margin-right: auto; }
  .brand svg { color: var(--accent-primary); flex-shrink: 0; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  nav a, footer a { display: inline-flex; align-items: center; min-height: 44px; }
  main { max-width: 1320px; margin: auto; padding: 2rem; min-height: 65vh; }
  footer { max-width: 1320px; margin: 2rem auto 0; border-top: 1px solid var(--border-subtle); padding: 2rem; display: flex; gap: 1rem; justify-content: space-between; flex-wrap: wrap; color: var(--text-secondary); }
  .skip { position: fixed; top: .5rem; left: 1rem; transform: translateY(-200%); z-index: 10; padding: .5rem 1rem; background: var(--surface); }
  .skip:focus { transform: none; }
  @media (max-width: 600px) { header, main, footer { padding: 1rem; } header { gap: 1rem; } nav { width: 100%; } .brand { font-size: 1.1rem; } }
</style>
