---
interface Props { kind: 'prompt' | 'context' }
const { kind } = Astro.props;
const prompt = kind === 'prompt';
const blocks = prompt
  ? [
    ['Задача', 'Сравни два тарифа'],
    ['Контекст', 'Условия и цены из справки'],
    ['Ограничения', 'Не придумывай отсутствующие данные'],
    ['Формат', 'Таблица и краткий вывод'],
  ]
  : [
    ['Инструкции', 'Что сделать и какие границы соблюдать'],
    ['Материалы', 'Данные и выбранная история диалога'],
    ['Ответ', 'Предусмотренное место для генерации'],
  ];
---
<figure data-learning-diagram={kind}>
  <figcaption>{prompt ? 'Четыре части проверяемого запроса' : 'Ограниченное окно контекста'}</figcaption>
  <ol>{blocks.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}</ol>
  <p>{prompt
    ? 'Части дополняют друг друга: формат не заменяет задачу, а ограничения не добавляют неизвестных фактов.'
    : 'Условная схема без масштаба. Входные материалы и генерируемый ответ должны укладываться в ограничения выбранной модели; конкретные лимиты нужно проверять отдельно.'}</p>
</figure>
<style>
  figure { margin: var(--space-8) 0; padding: var(--space-6); border: 1px solid var(--border-control); border-radius: var(--radius); background: var(--surface); }
  figcaption { font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-4); }
  ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--space-3); padding: 0; list-style-position: inside; }
  li { min-width: 0; padding: var(--space-4); background: var(--surface-raised); border-top: 2px solid var(--accent-secondary); overflow-wrap: anywhere; }
  li::marker { color: var(--info); font-family: var(--font-mono); }
  strong { color: var(--accent-primary); }
  span { display: block; margin-top: var(--space-2); }
  p { color: var(--text-secondary); margin-bottom: 0; }
</style>
